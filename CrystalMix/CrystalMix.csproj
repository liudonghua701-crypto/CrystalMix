<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CrystalMix</AssemblyName>
    <RootNamespace>CrystalMix</RootNamespace>
    <Version>1.1.0</Version>
    <ApplicationIcon>Assets\CrystalMix.ico</ApplicationIcon>
    <Authors>CrystalMix</Authors>
    <Product>CrystalMix Crystal Growth Ratio Calculator</Product>
    <Description>Bilingual crystal growth raw-material ratio calculator.</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\isotopes.json" />
    <EmbeddedResource Include="Assets\CrystalMix.ico" />
  </ItemGroup>
</Project>
